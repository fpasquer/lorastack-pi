# Copy this file to .env and fill in real, unique secrets.
# Generate values with: openssl rand -base64 32
# .env is git-ignored and must never be committed.

# PostgreSQL (ChirpStack database) — internal service, not exposed to the LAN.
POSTGRES_PASSWORD=replace-with-random-secret

# MQTT user used by ChirpStack (publish application events, gateway commands;
# subscribe gateway events + application commands).
MQTT_CHIRPSTACK_USERNAME=chirpstack
MQTT_CHIRPSTACK_PASSWORD=replace-with-random-secret

# MQTT user used by the ChirpStack Gateway Bridge (gateway <-> MQTT).
MQTT_GWBRIDGE_USERNAME=gatewaybridge
MQTT_GWBRIDGE_PASSWORD=replace-with-random-secret

# MQTT user used by the Symfony application on the laptop (Phase 8/9).
# Subscribe-only on application topics.
MQTT_SYMFONY_USERNAME=symfony
MQTT_SYMFONY_PASSWORD=replace-with-random-secret

# ChirpStack API secret (signs login and API tokens).
# Generate with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=replace-with-random-secret

# ChirpStack web UI admin password (reference copy only; not used by any
# service — the live value is set in the ChirpStack UI).
CHIRPSTACK_ADMIN_PASSWORD=replace-with-your-ui-password
